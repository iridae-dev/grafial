schema Social {
  node Person {
    some_value: Real
    other_value: Real
  }

  edge REL { }
}

belief_model SocialBeliefs on Social {
  node Person {
    some_value ~ Gaussian(mean=0.0, precision=0.1)
    other_value ~ Gaussian(mean=0.0, precision=0.1)
  }
  edge REL {
    exist ~ Bernoulli(prior=0.5, weight=2.0)
  }
}

evidence SocialEvidence on SocialBeliefs {
  Person {
    "Alice" { some_value: 10.0 },
    "Bob"   { some_value: 5.0 },
    "Carol" { some_value: 2.0 }
  }

  // Each repeated observation is one Bernoulli trial. With the Beta(1,1)
  // prior from Bernoulli(prior=0.5, weight=2.0), three 'present' sightings
  // give Beta(4,1): P(exist) = 4/5 = 0.8 per edge.
  REL(Person -> Person) {
    "Alice" -> "Bob"; "Alice" -> "Bob"; "Alice" -> "Bob";
    "Bob" -> "Carol"; "Bob" -> "Carol"; "Bob" -> "Carol"
  }
}

// Rule: Transfer value from A to B through intermediate node B,
// then disconnect B->C to prevent further propagation
rule TransferAndDisconnect on SocialBeliefs {
  pattern
    (A:Person)-[ab:REL]->(B:Person),
    (B:Person)-[bc:REL]->(C:Person)

  where
    // Only apply if both edges are highly probable.
    // Evidence gives P = 0.8 per edge, so the Alice->Bob->Carol chain matches.
    prob(ab) >= 0.75 and prob(bc) >= 0.75

  action {
    // Transfer half of A's value to B
    let v_ab = E[A.some_value] / 2
    non_bayesian_nudge A.some_value to E[A.some_value] - v_ab variance=preserve
    non_bayesian_nudge B.some_value to E[B.some_value] + v_ab variance=preserve // Disconnect B->C to prevent further propagation
    // delete ... confidence=high adds ~10⁹ absent pseudo-counts, driving P(exist) near zero
    // NOT exactly zero - still a valid probability distribution
    // Strong subsequent evidence could theoretically shift this belief
    delete bc confidence=high
  }

  mode: for_each
}

flow Demo on SocialBeliefs {
  graph base = from_evidence SocialEvidence

  // Apply rule to transfer value and disconnect
  graph transferred = base |> apply_rule TransferAndDisconnect

  // Prune low-probability edges (implicit 'edge' variable in where clause).
  // The rule drove P(Bob->Carol) to ~0 via delete, so it is pruned here;
  // Alice->Bob survives at P = 0.8.
  graph cleaned = transferred |> prune_edges REL where prob(edge) < 0.1

  // Compute average degree considering only high-probability edges.
  // One surviving edge across three people: avg_degree = 1/3.
  metric avg_degree = avg_degree(Person, REL, min_prob=0.75)

  export cleaned as "demo"
}

// Additional examples (not used in Demo flow):
// Node-only iteration sugar with a soft Bayesian update
rule BoostLowScores on SocialBeliefs {
  for (P:Person) where E[P.other_value] < 1.0 => {
    P.other_value ~= 1.0 precision=0.2
  }
}

// Edge cleanup based on probability
rule CleanupEdges on SocialBeliefs {
  pattern (A:Person)-[ab:REL]->(B:Person)
  where prob(ab) < 0.05 => {
    delete ab confidence=high
  }
}
