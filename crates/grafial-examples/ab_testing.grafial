// Example: Bayesian A/B Testing
// Classic application of Bayesian inference: comparing conversion rates between variants.
// Demonstrates proper Bayesian hypothesis testing and decision-making under uncertainty.

schema ABTest {
  node Variant {
    conversion_rate: Real
    sample_size: Real
  }
  edge OUTPERFORMS { }
}

belief_model TestBeliefs on ABTest {
  node Variant {
    // Prior: conversion rate around 10% (typical for web applications)
    // Moderate uncertainty to let data dominate after sufficient samples
    conversion_rate ~ Gaussian(
      mean=0.1,
      precision=10.0  // τ = 10 → σ² = 0.1
      // Prior standard deviation: √0.1 ≈ 0.316
    )
    sample_size ~ Gaussian(mean=1000.0, precision=0.01)
  }
  edge OUTPERFORMS {
    // Candidate hypothesis "X outperforms Y".
    // Prior: 50% chance (no preference before seeing data)
    exist ~ Bernoulli(prior=0.5, weight=2.0)  // Weak prior: Beta(1, 1) uniform
  }
}

// Both variants live in ONE evidence block so rules can compare them within a
// single graph. (Separate evidence blocks would build separate graphs.)
evidence ExperimentData on TestBeliefs {
  // KEY MODELING POINT: observation precision should scale with sample size.
  // A conversion rate estimated from 1000 impressions has sampling variance
  // p(1-p)/n ≈ 0.0001, so we use precision=100 (a conservative round figure)
  // rather than the default precision=1.
  //
  // Posterior for A: τ = 10 + 100 = 110, μ = (10×0.1 + 100×0.12) / 110 ≈ 0.1182
  // Posterior for B: τ = 10 + 100 = 110, μ = (10×0.1 + 100×0.15) / 110 ≈ 0.1455
  Variant {
    "A" { conversion_rate: 0.12 (precision=100.0), sample_size: 1000.0 },
    "B" { conversion_rate: 0.15 (precision=100.0), sample_size: 1000.0 }
  }

  // The hypothesis edge under test: "B outperforms A", observed once by an
  // analyst review. Beta(1,1) + 1 present → P(exist) = 2/3.
  OUTPERFORMS(Variant -> Variant) { "B" -> "A" }
}

// Rule to determine winner based on practical significance
rule DetermineWinner on TestBeliefs {
  pattern
    (W:Variant)-[wl:OUTPERFORMS]->(L:Variant)

  where
    // Statistical direction AND practical significance (2% lift):
    // E[B] - E[A] = 0.1455 - 0.1182 = 0.0273 > 0.02, so this fires.
    E[W.conversion_rate] > E[L.conversion_rate]
    and E[W.conversion_rate] - E[L.conversion_rate] > 0.02

  action {
    // Confirm the hypothesis edge with a strong observation and mark the
    // winner. In production, this might trigger deployment or further testing.
    non_bayesian_nudge W.conversion_rate to E[W.conversion_rate] * 1.01 variance=preserve
  }

  mode: for_each
}

flow ABTestAnalysis on TestBeliefs {
  graph experiment = from_evidence ExperimentData

  // Decision analysis:
  // - Posterior lift: E[B] - E[A] = 0.0273 (2.73 percentage points)
  // - Practical significance threshold: 2%
  // - Conclusion: B's lift is both statistically real and practically
  //   significant, so DetermineWinner fires and marks B.
  graph with_winner = experiment |> apply_rule DetermineWinner

  metric avg_conversion = nodes(Variant)
    |> where(E[node.sample_size] > 0.0)
    |> avg(by=E[node.conversion_rate])
  // Expected: (0.1182 + 0.1455×1.01) / 2 ≈ 0.1326 (B nudged by the winner mark)

  // Count variants whose posterior clears a 12% bar: only B (0.147)
  metric good_variants = nodes(Variant)
    |> where(E[node.conversion_rate] > 0.12)
    |> count()
  // Expected: 1

  export with_winner as "winner"
}

// Pedagogical points:
// 1. Bayesian A/B testing naturally incorporates prior knowledge
//    - Prior prevents overfitting to small samples
//    - Prior reflects baseline conversion rates from historical data
// 2. Observation precision must reflect sample size
//    - n=1000 impressions → sampling variance p(1-p)/n ≈ 1e-4 → precision ≈ 1e4
//      (we use a conservative 100 here to keep the prior visibly influential)
//    - Using the default precision=1 for aggregate data understates the
//      evidence and the prior swamps the data
// 3. Can make decisions before reaching "statistical significance"
//    - No need for fixed sample sizes or p-values
//    - Update beliefs continuously as data arrives
// 4. Separates statistical significance from practical significance
//    - Statistical: Is there a real difference? (Bayesian credible intervals)
//    - Practical: Does the difference matter? (Business thresholds)
// 5. Posterior uncertainty guides sample size requirements
//    - High uncertainty → need more data
//    - Low uncertainty → can make decision with confidence

// Advanced: Demonstrating decision-making with a threshold rule.
// Node-only iteration: fires for every Variant whose posterior clears the bar.
rule DecideWithLoss on TestBeliefs {
  for (A:Variant) where E[A.conversion_rate] > 0.11 => {
    // Deploy variant if it clears threshold.
    // In practice, would trigger deployment pipeline.
    non_bayesian_nudge A.conversion_rate to E[A.conversion_rate] * 1.05 variance=preserve
  }
}

// Additional examples (not used in flows):
// Node-only iteration sugar with a soft update for calibration
rule CalibrateLowRates on TestBeliefs {
  for (V:Variant) where E[V.conversion_rate] < 0.08 => {
    V.conversion_rate ~= 0.09 precision=0.5
  }
}

// Cleanup weak OUTPERFORMS edges
rule CleanupWeakEdges on TestBeliefs {
  pattern (X:Variant)-[xy:OUTPERFORMS]->(Y:Variant)
  where prob(xy) < 0.05 => {
    delete xy confidence=high
  }
}

// Note on sample size calculation:
// Traditional frequentist: fix N in advance based on power analysis
// Bayesian approach: sequential testing with posterior credible intervals
//   - Stop when P(B > A | data) > 0.95 and |E[B] - E[A]| > threshold
//   - Or when credible intervals overlap significantly (no meaningful difference)
//   - No inflation of Type I error from "peeking" at results
